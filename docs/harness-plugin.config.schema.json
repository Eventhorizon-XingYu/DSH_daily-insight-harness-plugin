{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "daily-insight.config.schema.json",
  "type": "object",
  "required": ["schedule", "topics", "search", "video", "llm", "output"],
  "additionalProperties": false,
  "properties": {
    "schedule": {"type":"object","required":["time","timezone"],"additionalProperties":false,"properties":{"time":{"type":"string","pattern":"^(?:[01]\\d|2[0-3]):[0-5]\\d$"},"timezone":{"type":"string","minLength":1}}},
    "topics": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "search": {"type":"object","required":["engine","max_results_per_keyword","max_keywords"],"additionalProperties":false,"properties":{"engine":{"enum":["duckduckgo","serpapi","tavily"]},"max_results_per_keyword":{"type":"integer","minimum":1,"maximum":50},"max_keywords":{"type":"integer","minimum":1,"maximum":20}}},
    "video": {"type":"object","required":["platforms","max_videos"],"additionalProperties":false,"properties":{"platforms":{"type":"array","items":{"enum":["youtube","bilibili"]}},"max_videos":{"type":"integer","minimum":0,"maximum":20}}},
    "llm": {"type":"object","required":["provider","base_url","model","temperature","max_tokens"],"additionalProperties":false,"properties":{"provider":{"type":"string","minLength":1},"base_url":{"type":"string","format":"uri","pattern":"^https://"},"model":{"type":"string","minLength":1},"temperature":{"type":"number","minimum":0,"maximum":2},"max_tokens":{"type":"integer","minimum":1,"maximum":32768}}},
    "output": {"type":"object","required":["dir","naming"],"additionalProperties":false,"properties":{"dir":{"type":"string","minLength":1},"naming":{"type":"string","minLength":1,"pattern":"^[^/\\\\]*$"}}}
  }
}
